<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by TrayIconRenderer.IcoFile; regenerate with the write-icon diagnostic (see README). -->
    <ApplicationIcon>PCVitals.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>PCVitals</AssemblyName>
    <Product>PC Vitals</Product>
    <Version>1.1.1</Version>

    <!-- Footprint: precompile to native code (no JIT at startup), skip ICU, and use a GC tuned
         for a small, long-running background process instead of throughput. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in tests/ under this folder; keep its sources out of the app. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <InternalsVisibleTo Include="PCVitals.Tests" />
    <Using Include="PCVitals.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compact aggressively and give memory back to the OS rather than keeping it for reuse. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
    <!-- The gen0 budget scales with L3 cache size; on big-cache CPUs (e.g. 96 MB on X3D parts) it let
         ~40+ MB of garbage pile up between collections. A hard limit caps the budget at ~5 MB.
         The live heap is ~3-11 MB, but drive discovery allocates ~40 MB once with 3 drives, so 128 MB
         leaves room for PCs with many drives. TrayContext logs the heap when discovery comes near it. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="0x8000000" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact version: HardwareService relies on a few of its internals (see the *Gate classes).
         Re-check those, and the log, before upgrading. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="[0.9.6]" />
  </ItemGroup>

</Project>
